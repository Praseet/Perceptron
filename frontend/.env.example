# AFL Frontend - Environment Variables
# Copy to .env.local for local dev

# Backend API base URL. Vite dev server proxies /api/* to this.
VITE_API_BASE_URL=http://localhost:8000

# Demo mode - when true, every API endpoint returns canned data so the
# demo never breaks even if the backend is down. Phase 11 flips to false
# only on demo day itself.
VITE_DEMO_MODE=true